FROM node:22-bookworm-slim
RUN mkdir -p /app /data && chown node:node /app /data
WORKDIR /app
COPY --chown=node:node . .
USER node
ENV NODE_OPTIONS=--max-old-space-size=1536 WRANGLER_SEND_METRICS=false
RUN npm run install:ci
RUN node --experimental-transform-types --test tests/*.test.mjs
RUN npm run build
RUN node deploy/vps/configure.mjs
EXPOSE 3000
CMD ["sh", "deploy/vps/start.sh"]
